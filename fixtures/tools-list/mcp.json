                    "known": {
                      "type": "integer"
                    },
                    "lookup_failed": {
                      "type": "boolean"
                    },
                    "names": {
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "null",
                        "array"
                      ]
                    },
                    "shared": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "known"
                  ],
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "confidence": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "last_seen": {
