    {
      "description": "Read one note you sent to the Context team by its ref (send_feedback returns it), and what came of it. Only your own notes can be read.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "feedback_id": {
            "description": "the note's ref, as send_feedback or list_my_feedback returned it",
            "type": "string"
          }
        },
        "required": [
          "feedback_id"
        ],
        "type": "object"
      },
      "name": "get_my_feedback",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "additionalProperties": false,
            "properties": {
              "created_at": {
                "type": "string"
              },
              "id": {
                "description": "the note's ref; pass it to get_my_feedback",
                "type": "string"
              },
              "page_label": {
                "description": "where it was sent from",
                "type": "string"
              },
              "problems": {
                "description": "what the team logged from this note and where each stands",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "can_answer": {
                      "description": "true while Context is asking whether the fix worked; answer in the web app",
                      "type": "boolean"
                    },
                    "closed_reason": {
                      "description": "why the team decided not to fix it",
                      "type": "string"
                    },
                    "comment": {
                      "description": "the user's own comment that the fix did not work",
                      "type": "string"
                    },
                    "fix": {
                      "additionalProperties": false,
                      "description": "the fix we shipped, when there is one",
                      "properties": {
                        "date": {
                          "type": "string"
                        },
                        "message": {
                          "description": "what changed, in the words shown in the app",
                          "type": "string"
                        }
                      },
                      "required": [
                        "date",
                        "message"
                      ],
                      "type": [
                        "null",
                        "object"
                      ]
                    },
                    "since": {
                      "type": "string"
                    },
                    "status": {
                      "description": "logged, in_progress, fixed, confirmed, still_broken or closed",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "can_answer"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "status": {
                "description": "acknowledged (a thumbs-up), received (nobody has logged it yet), or the status of the problem logged from it",
                "type": "string"
              },
              "subject": {
                "description": "the record or investigation it was about",
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "text": {
                "description": "what the user sent",
                "type": "string"
              }
            },
            "required": [
              "id",
              "created_at",
              "text",
              "status",
              "problems"
            ],
            "type": "object"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "note",
          "path"
        ],
        "type": "object"
      }
    },
