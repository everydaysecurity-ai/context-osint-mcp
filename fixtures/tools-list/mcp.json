{
  "tools": [
    {
      "description": "Submit a URL to the honeypot crawler and return the crawl job id. Crawling is performed by isolated honeypot infrastructure, never from this service. Returns immediately with a job id; poll get_crawl for status and results.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "intent": {
            "description": "one of 'user-waiting' (the default) or 'background'; controls the crawler's admission priority tier",
            "type": "string"
          },
          "reason": {
            "description": "free-text audit note describing why this crawl was requested",
            "type": "string"
          },
          "url": {
            "description": "the URL to crawl",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "enqueue_crawl",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "deduped": {
            "type": "boolean"
          },
          "job_id": {
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "deduped"
        ],
        "type": "object"
      }
    },
    {
      "description": "Look up one crawl job by id: its status, seed URL, failure reason, risk assessment, analysis projection, and an index of the evidence artifacts it produced. The artifact index lists evidence types and keys only \u2014 call get_crawl_artifact to read an artifact's contents.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "description": "the crawl job id returned by enqueue_crawl",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      },
      "name": "get_crawl",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "analysis": {
            "description": "the crawler's opaque analysis projection, forwarded whole and not modelled by this service"
          },
          "artifacts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence_type": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "pi_id": {
                  "description": "the crawler device identity whose phone produced this artifact",
                  "type": "string"
                }
              },
              "required": [
                "evidence_type",
                "key"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "failure_reason": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "risk": {
            "additionalProperties": false,
            "properties": {
              "band": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "ruleset_version": {
                "type": "string"
              },
              "score": {
                "type": "integer"
              },
              "top_contributors": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "evidence_refs": {
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "null",
                        "array"
                      ]
                    },
                    "feature": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer"
                    },
                    "why": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "feature",
                    "points",
                    "why",
                    "evidence_refs"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "score",
              "band",
              "top_contributors"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "seed_url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "seed_url",
          "artifacts"
        ],
        "type": "object"
      }
    },
    {
      "description": "Fetch the contents of one evidence artifact from a crawl job. Text artifacts (dom, console, network, cdp-status) are returned inline as text, truncated past 256KB with a note. Binary artifacts (screenshot, har) are returned as an embedded resource, or \u2014 past 2MB \u2014 as a type/size summary only. This tool never returns a downloadable link; contents are fetched server-side.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "evidence_type": {
            "description": "one of dom, console, network, cdp-status, screenshot, har",
            "type": "string"
          },
          "job_id": {
            "description": "the crawl job id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "evidence_type"
        ],
        "type": "object"
      },
      "name": "get_crawl_artifact"
    },
    {
      "description": "Look up everything Context knows about one indicator: when it was first and last seen, how often, its tags and sources, the attributes observed on it (registration, hosting, capture, verdict), where it has been seen, and the related indicators it connects to. Reads existing evidence only \u2014 it never crawls, and never queues one. Use enqueue_crawl when the answer is that nothing is known yet.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "description": "optional indicator type (url, domain, ip, email, phone, business, person, address, organization); inferred from value when omitted",
            "type": "string"
          },
          "value": {
            "description": "the indicator to look up - a URL, domain, IP, email, phone, company name or registration number",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
