        "properties": {
          "question": {
            "description": "a question about state business registrations, e.g. 'addresses in WA with 2 to 9 businesses at their own office', 'people who govern 3 or more businesses', 'businesses registered by Northwest Registered Agent in September 2026'",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "name": "search_business_records",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "additionalProperties": false,
            "properties": {
              "args": {
                "additionalProperties": true,
                "type": "object"
              },
              "parsed_by": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "tool",
              "args",
              "summary",
              "parsed_by"
            ],
            "type": "object"
          },
          "result": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "query",
          "result"
        ],
        "type": "object"
      }
    },
    {
      "description": "Send feedback to the Context team: the same as the feedback panel in Context's web app. Call it ONLY when the user asks you to send feedback, and send what they said in their words. Never call it on your own initiative, and never to report a failed tool call. When the user says something works well, send it with positive true (a thumbs-up; words optional): it is acknowledged on arrival, with nothing to fix. Name the indicator or investigation the feedback is about when there is one, so the team can see what the user saw. The user can follow what comes of it under Your feedback in Context.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "indicator": {
            "description": "optional: the URL, domain, IP or other indicator the feedback is about",
            "type": "string"
          },
          "indicator_type": {
            "description": "optional type of indicator (url, domain, ip, ...); used only when Context cannot infer it from the value",
            "type": "string"
          },
          "investigation_id": {
            "description": "optional: the investigation the feedback is about, instead of an indicator",
            "type": "string"
          },
          "message": {
            "description": "the feedback, in the user's own words; optional only with positive",
            "type": "string"
          },
          "positive": {
