                  },
                  "type": "object"
                },
                "first_seen_at": {
                  "type": "string"
                },
                "investigation_id": {
                  "type": "string"
                },
                "investigation_title": {
                  "type": "string"
                },
                "node_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "seen_at": {
